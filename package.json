{
  "name": "pearl-readers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:content": "node scripts/validate-content.js && node scripts/validate-rescues.js",
    "build": "npm run validate:content && vite build && node scripts/build-offline.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
